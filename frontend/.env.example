# Supabase — Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# Supabase server-side (service role — never expose to the client)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Database — Supabase → Settings → Database → Connection string
# Pooled connection (used at runtime via Prisma)
DATABASE_URL=postgresql://user:password@host:6543/postgres?pgbouncer=true

# Direct connection (used for Prisma migrations)
DIRECT_URL=postgresql://user:password@host:5432/postgres

# Encryption (64-char hex string — generate with: openssl rand -hex 32)
ENCRYPTION_KEY=your-64-char-hex-encryption-key-here

# Demo mode — set false until smoke tests pass, then flip true
# Requires PLATFORM_OPENAI_KEY to be set
PLATFORM_DEMO_ENABLED=false
PLATFORM_OPENAI_KEY=sk-...

# AI Providers (optional — users configure their own via the UI)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...


# Upstash Redis — optional, enables distributed rate limiting on Vercel serverless
# Without these, rate limiting falls back to per-instance in-memory counters
# UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-token
