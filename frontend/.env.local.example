# Supabase — get from Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# Use publishable key (new) or legacy anon JWT — at least one is required
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...  # if not using publishable

# Platform demo mode — lets new users try 5 runs without a BYOK API key
# Feature is dormant (disabled) unless PLATFORM_DEMO_ENABLED=true
PLATFORM_DEMO_ENABLED=false
# Platform OpenAI key used exclusively for demo runs (gpt-4o-mini)
# PLATFORM_OPENAI_KEY=sk-...
# Daily spend cap in USD before demo is paused (default: $5 ≈ 15k runs/day)
# PLATFORM_DEMO_DAILY_CAP_USD=5

